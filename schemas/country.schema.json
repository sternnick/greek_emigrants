{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greek-diaspora.local/schemas/country.schema.json",
  "type": "object",
  "required": ["id", "iso_alpha2", "name", "continent", "status", "records"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Slug" },
    "iso_alpha2": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "name": { "$ref": "common.schema.json#/$defs/I18nString" },
    "continent": { "$ref": "common.schema.json#/$defs/Slug" },
    "status": {
      "type": "string",
      "enum": ["stub", "partial", "complete", "disputed"],
      "description": "Coverage state. stub = no records yet (records: []); partial = at least one confirmed record, no hypothetical with a value; complete = both classifications present; disputed = sources disagree on material facts (takes precedence over complete)."
    },
    "total_population": {
      "type": "object",
      "required": ["count", "year", "source_ref"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "year": { "type": "integer" },
        "source_ref": { "$ref": "common.schema.json#/$defs/Slug" }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_id", "year", "count", "source_ref",
          "classification", "method", "definition", "population_type",
          "evidence", "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "record_id": { "$ref": "common.schema.json#/$defs/Slug" },
          "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
          "count": {
            "oneOf": [
              { "type": "integer", "minimum": 0 },
              { "type": "null" }
            ]
          },
          "source_ref": { "$ref": "common.schema.json#/$defs/Slug" },
          "classification": { "$ref": "common.schema.json#/$defs/Classification" },
          "method": { "$ref": "common.schema.json#/$defs/Method" },
          "definition": { "$ref": "common.schema.json#/$defs/Definition" },
          "population_type": { "$ref": "common.schema.json#/$defs/PopulationType" },
          "generation": {
            "type": "string",
            "enum": ["any", "first", "second", "third-plus"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/EvidenceCitation" }
          },
          "verification": { "$ref": "common.schema.json#/$defs/Verification" },
          "dispute_note": { "$ref": "common.schema.json#/$defs/I18nString" },
          "status": {
            "type": "string",
            "enum": ["verified", "disputed", "historical"],
            "description": "verified = matches its published source; disputed = value corrected or not confirmable (dispute_note required); historical = dated past figure kept for the time series."
          },
          "notes": { "$ref": "common.schema.json#/$defs/I18nString" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "stub" } },
        "required": ["status"]
      },
      "then": { "properties": { "records": { "type": "array" } } },
      "else": { "properties": { "records": { "type": "array", "minItems": 1 } } }
    }
  ]
}
