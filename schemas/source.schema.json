{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greek-diaspora.local/schemas/source.schema.json",
  "type": "object",
  "required": [
    "id", "title", "publisher", "country", "year",
    "url", "classification", "type", "scope",
    "reliability", "publication", "independence", "language", "language_iso639_2b"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/Slug" },
    "title": { "$ref": "common.schema.json#/$defs/I18nString" },
    "publisher": { "$ref": "common.schema.json#/$defs/I18nString" },
    "country": { "$ref": "common.schema.json#/$defs/Slug" },
    "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
    "url": { "type": "string", "minLength": 1 },
    "classification": { "$ref": "common.schema.json#/$defs/Classification" },
    "type": { "$ref": "common.schema.json#/$defs/SourceType" },
    "scope": { "$ref": "common.schema.json#/$defs/Definition" },
    "reliability": { "$ref": "common.schema.json#/$defs/Reliability" },
    "publication": {
      "type": "object",
      "required": ["retrieved_at"],
      "additionalProperties": false,
      "properties": {
        "published_at": { "type": "string", "format": "date" },
        "updated_at": { "type": "string", "format": "date" },
        "retrieved_at": { "type": "string", "format": "date" }
      }
    },
    "independence": {
      "type": "object",
      "required": ["primary_data_collector"],
      "additionalProperties": false,
      "properties": {
        "primary_data_collector": { "type": "boolean" },
        "derives_from": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/Slug" },
          "uniqueItems": true
        },
        "notes": { "$ref": "common.schema.json#/$defs/I18nString" }
      }
    },
    "agency": { "$ref": "common.schema.json#/$defs/I18nString" },
    "robots_txt_allows_fetch": { "type": "boolean" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "language_iso639_2b": {
      "type": "string",
      "pattern": "^[a-z]{3}$",
      "description": "ISO 639-2/B bibliographic code for the same language, for repository/COAR language metadata. Must agree with `language` — checked against i18n/languages.json."
    },
    "notes": { "$ref": "common.schema.json#/$defs/I18nString" }
  }
}
