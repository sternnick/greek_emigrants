{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greek-diaspora.local/schemas/common.schema.json",
  "$defs": {
    "I18nString": {
      "type": "object",
      "required": ["el", "en"],
      "additionalProperties": false,
      "properties": {
        "el": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "Classification": {
      "type": "string",
      "enum": ["confirmed", "hypothetical"]
    },
    "Definition": {
      "type": "string",
      "enum": ["greek-citizens", "greek-ethnic", "greek-origin", "greek-language", "greek-born"]
    },
    "EvidenceCitation": {
      "type": "object",
      "required": ["source_ref", "url", "accessed_at"],
      "additionalProperties": false,
      "properties": {
        "source_ref": { "$ref": "#/$defs/Slug" },
        "url": { "type": "string", "format": "uri" },
        "archive_url": { "type": "string", "format": "uri" },
        "accessed_at": { "type": "string", "format": "date" },
        "published_at": { "type": "string", "format": "date" },
        "updated_at": { "type": "string", "format": "date" },
        "page_or_table": { "type": "string" },
        "quote": { "$ref": "#/$defs/I18nString" },
        "quote_language": { "type": "string" }
      }
    },
    "Verification": {
      "type": "object",
      "required": ["independent_sources", "confidence"],
      "additionalProperties": false,
      "properties": {
        "independent_sources": { "type": "integer", "minimum": 0, "maximum": 20 },
        "confidence": {
          "type": "string",
          "enum": ["single-source", "corroborated", "well-established"]
        },
        "corroborating_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Slug" },
          "uniqueItems": true
        },
        "independence_note": { "$ref": "#/$defs/I18nString" }
      }
    },
    "PopulationType": {
      "type": "string",
      "enum": ["diaspora", "indigenous-minority"]
    },
    "Method": {
      "type": "string",
      "enum": ["census", "register", "survey", "estimate", "academic"]
    },
    "Reliability": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "SourceType": {
      "type": "string",
      "enum": [
        "census",
        "register",
        "survey",
        "official-statistics",
        "community-estimate",
        "media",
        "academic-extrapolation",
        "self-report",
        "government-portal",
        "international-org",
        "diaspora-federation"
      ]
    },
    "FlowDirection": {
      "type": "string",
      "enum": ["outflow", "return"]
    }
  }
}
